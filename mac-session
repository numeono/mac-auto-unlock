#!/usr/bin/env python3
"""Request bounded desktop access. This client never handles a password."""
import argparse
import json
import os
import pathlib
import socket
import stat
import sys

def request(payload):
    base = pathlib.Path.home() / 'Library/Application Support/MacSessionHelper'
    st = base.lstat()
    if not stat.S_ISDIR(st.st_mode) or st.st_uid != os.getuid() or st.st_mode & 0o077:
        raise RuntimeError('Unsafe helper directory.')
    path = base / 'control.sock'
    st = path.lstat()
    if not stat.S_ISSOCK(st.st_mode) or st.st_uid != os.getuid() or st.st_mode & 0o077:
        raise RuntimeError('Unsafe helper socket.')
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as conn:
        # Allow bounded display wake, secure-focus settling and unlock checks.
        conn.settimeout(60)
        conn.connect(str(path))
        conn.sendall(json.dumps(payload).encode() + b'\n')
        response = bytearray()
        while b'\n' not in response and len(response) < 16384:
            chunk = conn.recv(4096)
            if not chunk:
                break
            response.extend(chunk)
    return json.loads(response)

def main():
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest='command', required=True)
    for name in ('status', 'setup', 'request-permissions', 'lock', 'pause', 'test-cycle', 'wake-check'):
        sub.add_parser(name)
    begin = sub.add_parser('begin')
    begin.add_argument('--seconds', type=int, default=900)
    renew = sub.add_parser('renew')
    renew.add_argument('lease')
    renew.add_argument('--seconds', type=int, default=900)
    end = sub.add_parser('end')
    end.add_argument('lease')
    args = vars(parser.parse_args())
    try:
        result = request(args)
    except (OSError, ValueError, RuntimeError) as exc:
        result = {'ok': False, 'error': str(exc), 'hint': 'The helper must be running in your logged-in Mac session.'}
    print(json.dumps(result, sort_keys=True))
    return 0 if result.get('ok') else 1

if __name__ == '__main__':
    sys.exit(main())
